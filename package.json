{
  "name": "stenvera-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mark Veenstra's bilingual personal website on Cloudflare Workers Static Assets",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "test": "node tests/check.mjs",
    "deploy": "wrangler deploy",
    "deploy:local": "npm run build && wrangler deploy",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.65.1",
    "wrangler": "4.164.0"
  },
  "engines": {
    "node": ">=20"
  }
}
